# Nginx server block for the JC-Market SANDBOX subdomain.
#
# One-time setup on the droplet:
#   sudo cp scripts/nginx-sandbox.conf.example /etc/nginx/sites-available/jc-market-sandbox
#   sudo ln -s /etc/nginx/sites-available/jc-market-sandbox /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d sandbox.jianchathailand.com   # adds HTTPS + auto-renew
#
# certbot rewrites this block to add the SSL lines and an HTTP->HTTPS redirect.
# The sandbox app listens on 127.0.0.1:3864 (see ecosystem.sandbox.config.js / .env).

server {
    listen 80;
    listen [::]:80;
    server_name sandbox.jianchathailand.com;

    # generous upload size for slips / invoices (matches the app's 10MB multer limit)
    client_max_body_size 12M;

    location / {
        proxy_pass         http://127.0.0.1:3864;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 90s;
    }
}
