# Server
PORT=3862
JWT_SECRET=change-me-in-production-jc-stock-market

# D365 BC OAuth2
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=Production
BC_COMPANY_ID=
BC_API_BASE=https://api.businesscentral.dynamics.com/v2.0

# Default vendor for auto-created Purchase Orders.
# When Finance approves a slip, both SO and PO are created in BC. The PO
# always uses this vendor number — e.g. the HQ wholesaler / central kitchen
# supplier. Leave blank to disable auto-PO (admin can still create PO
# manually via the Approvals "Approved" tab).
BC_DEFAULT_VENDOR_NO=

# BC Web Service names for the JC master transfer flow. These must match the
# Service Name column on BC's "Web Services" page (Page 5740 for the header,
# Page 5741 for the lines). Defaults assume "TransferOrder" / "TransferOrderLine".
BC_WS_TRANSFER_ORDER=TransferOrder
BC_WS_TRANSFER_ORDER_LINE=TransferOrderLine

# PromptPay (เบอร์/เลขนิติบุคคลที่รับเงิน)
PROMPTPAY_ID=

# SlipOK (auto-verify slip) — https://slipok.com
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# Sync
ITEM_SYNC_INTERVAL_MINUTES=5
USE_MOCK_BC=1

# JC master slip upload — 1 = JC-master (company-owned) branches also use the
# QR + slip payment flow (accounting unchanged: VAT 0, BC TRO/PO on verify).
# 0 (default) = original no-pay JC behaviour.
JC_ALLOW_SLIP=0
